local classptr = ffi.typeof("void***")
local rawientitylist = client.create_interface("client.dll", "VClientEntityList003") or error("VClientEntityList003 not found")
local ientitylist = ffi.cast(classptr, rawientitylist)
local get_client_entity = ffi.cast("void*(__thiscall*)(void*, int)", ientitylist[0][3])

-- NOTE: offsets can change between game builds
local OFF_ANIMOVERLAY = 0x2990
local OFF_ANIMSTATE   = 0x9960

local function get_anim_layer(ent, layer)
    local ptr = get_client_entity(ientitylist, ent)
    if ptr == nil then return nil end
    local arr = ffi.cast("struct gd_animation_layer_t**", ffi.cast("char*", ptr) + OFF_ANIMOVERLAY)[0]
    if arr == nil then return nil end
    return arr[layer or 6]
end

local function get_animstate(ent)
    local ptr = get_client_entity(ientitylist, ent)
    if ptr == nil then return nil end
    local as = ffi.cast("struct gd_animstate**", ffi.cast("char*", ptr) + OFF_ANIMSTATE)[0]
    if as == nil then return nil end
    return as
end

-- ====================== Helpers ======================
local function clamp(v, lo, hi) return math.max(lo, math.min(hi, v)) end
local function sign(x) return x > 0 and 1 or (x < 0 and -1 or 0) end

local function normalize_yaw(y)
    y = math.fmod(y, 360)
    if y > 180 then y = y - 360 elseif y < -180 then y = y + 360 end
    return y
end
local function angle_diff(a, b) return normalize_yaw(a - b) end

local function get_max_desync(ent)
    local as = get_animstate(ent)
    if not as then return 58 end
    local speedfactor = clamp(as.m_flFeetSpeedForwardsOrSideWays, 0, 1)
    local avg = (as.m_flStopToFullRunningFraction * -0.3 - 0.2) * speedfactor + 1
    if as.m_fDuckAmount > 0 then
        avg = avg + (as.m_fDuckAmount * speedfactor * (0.5 - avg))
    end
    return clamp(avg, 0.5, 1) * 58
end

local function get_state(ent, speed)
    local fl = entity.get_prop(ent, "m_fFlags") or 1
    if bit.band(fl, 1) == 0 then return "air" end
    if speed > 5 then return "move" end
    return "stand"
end

